{
  "name": "tarnisheds-arsenal-desktop",
  "private": true,
  "version": "0.14.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "test:contracts": "node scripts/check-dto-contract.mjs && node --test scripts/check-dto-contract.test.mjs scripts/lint-config.test.mjs",
