{
  "name": "tarnisheds-arsenal-desktop",
  "private": true,
  "version": "0.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && tsc -p tsconfig.tests.json && tsc -p tsconfig.scripts.json",
    "test:contracts": "node --test scripts/check-dto-contract.test.mjs scripts/lint-config.test.mjs scripts/native-responsiveness-metrics.test.mjs",
    "tauri": "tauri",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "test:packaged": "node ./scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
