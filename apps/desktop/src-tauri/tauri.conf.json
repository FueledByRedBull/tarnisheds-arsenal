{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarnished's Arsenal",
  "version": "0.4.6",
  "identifier": "com.tarnishedsarsenal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tarnished's Arsenal",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../../data/phase1/*.csv": "data/phase1/"
    }
  }
}
